# =============================================================================
# Root .dockerignore for YOLO Object Distance System
# Prevents bulky, non-production, or sensitive files from bloating build context
# =============================================================================

# Version control and agent metadata
.git/
.gitignore
.agents/

# Python cache & virtual environment artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & benchmark artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
benchmarks/
stress_testing/
tests/
e2e_tests/
benchmark_results.json
stress_test_report.json

# Node & Frontend build artifacts
node_modules/
frontend/node_modules/
frontend/dist/
.npm
npm-debug.log*

# Documentation & IDE
.vscode/
.idea/
*.swp
*.swo
*.md
!README.md

# Log files and temporary files
*.log
*.tmp
*.temp

# Do NOT ignore model weights or backend requirements
!yolov8n.pt
!backend/
!requirements.txt
